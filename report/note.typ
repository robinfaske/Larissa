    #railrow("Sizing")[#n.br_ratio in 5y per 1.00 of 10y; heavy discounting at #n.br_y10% equalizes zero-coupon DV01s]
    #railrow("Entry")[5y #n.br_y5% / 10y #n.br_y10%; slope #n.br_slope bp]
    #railrow("Carry + roll")[#n.br_carry bp per 3m per unit DV01; #n.br_cv per unit of 3m vol (#n.br_vol bp)]
    #railrow("Invalidation")[slope #n.br_inval bp, one 5y $sigma$ against ($sigma$ = #n.br_sigma5y bp)]
    #railrow("Horizon")[3m, rolled while the path stays unpriced]
