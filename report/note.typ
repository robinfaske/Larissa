// and includes/*.csv, generated by scripts/build_report.py (no hand-typed
// figures). Content is frozen from Phase 2; this is the institutional restyle.
#import "/report/includes/vars.typ": n

#let ink = rgb("#0b0b0b")
#let muted = rgb("#52514e")
#let hair = rgb("#c3c2b7")
#let accent = rgb("#b5541f")
#let railbg = rgb("#f5f3ef")

#set page("a4", margin: (x: 1.7cm, top: 1.5cm, bottom: 1.6cm),
  footer: context [
    #set text(size: 7.5pt, fill: muted)
    #line(length: 100%, stroke: 0.4pt + hair)
    #v(2pt)
    Views my own; all data free and public. Not investment advice.
    #h(1fr)
    Priced to Stand Still · #n.date · #counter(page).display("1 of 1", both: true)
  ])
#set text(size: 9.3pt, font: "STIX Two Text", fill: ink)
#show math.equation: set text(font: "STIX Two Math")
#set par(justify: true, leading: 0.58em, spacing: 0.62em)

#show heading.where(level: 1): it => block(above: 0.9em, below: 0.5em)[
  #set text(size: 9.7pt, weight: "bold")
  #smallcaps(lower(it.body))
  #v(-0.42em) #line(length: 100%, stroke: 0.5pt + hair)
]

// booktabs-style table: no vertical rules, thin horizontals, right-aligned
// numerics with tabular figures, units live in the header.
#let booktabs(path, fs: 8.3pt) = {
  let rows = csv(path)
  set text(size: fs, number-width: "tabular")
  table(
    columns: rows.first().len(),
    align: (x, _) => if x == 0 { left } else { right },
    stroke: none, inset: (x: 5pt, y: 2.7pt),
    table.hline(stroke: 0.8pt),
    table.header(..rows.first().map(c => text(weight: "bold")[#c])),
    table.hline(stroke: 0.4pt),
    ..rows.slice(1).flatten(),
    table.hline(stroke: 0.8pt),
  )
}

#let owner(body) = block(inset: (left: 6pt), stroke: (left: 1.5pt + accent), below: 0.6em)[
  #text(size: 7.8pt, fill: accent, weight: "bold", tracking: 0.3pt)[OWNER — REWRITE IN YOUR VOICE]
  #v(-0.2em) #body]
#show figure.caption: it => align(center, block(width: 93%, above: 0.5em)[
  #set text(size: 8.1pt, fill: muted)
  #text(weight: "bold", fill: ink)[#it.supplement #context it.counter.display().] #it.body
])
#let railrow(label, body) = [
  #text(size: 7.3pt, fill: muted, weight: "bold", tracking: 0.2pt)[#upper(label)] \
  #text(size: 8.5pt)[#body]
  #v(3.5pt)
]

