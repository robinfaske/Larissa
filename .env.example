# Keys are only needed for --refresh (pulling fresh data).
# Reproduction from the committed cache needs no keys at all.

# Banxico SIE API token (free): https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=

# TCMB EVDS key (free, for Turkey once enabled in M5): https://evds2.tcmb.gov.tr
EVDS_KEY=
